<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <RelativeLayout
        android:id="@+id/leftLayout"
        style="@style/title_bar_layout_left">
        <ImageView
            android:id="@+id/leftIcon"
            android:visibility="gone"
            android:clickable="false"
            style="@style/title_bar_layout_icon"/>
        <TextView
            android:textSize="14sp"
            android:id="@+id/leftText"
            android:clickable="false"
            android:text=""
            android:layout_toRightOf="@+id/leftIcon"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/leftIcon"
            style="@style/title_bar_layout_text"/>
    </RelativeLayout>
    <TextView
        android:textSize="18sp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/centerText"
        android:background="#0000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="title"
        android:layout_centerInParent="true"
        android:layout_marginStart="12dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/rightLayout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        style="@style/title_bar_layout_right">
        <ImageView
            android:id="@+id/rightIcon"
            android:visibility="gone"
            android:clickable="false"
            android:tint="@color/white"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            style="@style/title_bar_layout_icon"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/white"
            android:id="@+id/rightText"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text=""
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            style="@style/title_bar_layout_text"/>
    </LinearLayout>
</RelativeLayout>
