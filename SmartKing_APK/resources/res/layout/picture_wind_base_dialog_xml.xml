<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/dialog_shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textColor="#ff572e"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="提示"
            android:layout_weight="1"/>
        <TextView
            android:background="@color/line_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5">
            <TextView
                android:textSize="15sp"
                android:textColor="#53575e"
                android:gravity="center"
                android:id="@+id/tv_content"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="更新内容"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:background="@color/line_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <Button
                    android:textColor="#529bea"
                    android:id="@+id/btn_cancel"
                    android:background="@drawable/btn_left_bottom_selector"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="取消"
                    android:layout_weight="1"/>
                <TextView
                    android:background="@color/line_color"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"/>
                <Button
                    android:textColor="#529bea"
                    android:id="@+id/btn_commit"
                    android:background="@drawable/btn_right_bottom_selector"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="确定"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
