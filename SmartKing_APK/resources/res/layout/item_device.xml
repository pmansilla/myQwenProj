<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#0000"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="45dp">
    <RelativeLayout
        android:id="@+id/itemLayout"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        style="@style/setting_rl_layout">
        <ImageView
            android:id="@+id/image"
            android:src="@mipmap/ic_sk"
            style="@style/setting_rl_layout_left"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:id="@+id/name"
                android:text="name"
                style="@style/setting_rl_layout_center"/>
            <TextView
                android:textSize="16sp"
                android:id="@+id/mac"
                android:text="mac"
                style="@style/setting_rl_layout_center"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/deviceConnFlag"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="10dp"
            android:src="@mipmap/ico_ble"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/gray"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/itemLayout"/>
</RelativeLayout>
