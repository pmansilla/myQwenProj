<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/DIMEN_128PX">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/title_out_frame"
        android:background="@color/pink"
        android:layout_width="match_parent"
        android:layout_height="@dimen/DIMEN_88PX"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_left_area"
            android:paddingLeft="@dimen/DIMEN_20PX"
            android:paddingRight="@dimen/DIMEN_20PX"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:paddingStart="@dimen/DIMEN_20PX"
            android:paddingEnd="@dimen/DIMEN_20PX"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/title_left_btn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/DIMEN_60PX"
                android:layout_marginRight="@dimen/DIMEN_18PX"
                android:src="@mipmap/back"
                android:layout_marginEnd="@dimen/DIMEN_18PX"/>
            <TextView
                android:textSize="@dimen/DIMEN_32PX"
                android:textColor="@color/white"
                android:id="@+id/title_left"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/DIMEN_36PX"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/title_middle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/DIMEN_20PX"
            android:layout_marginRight="@dimen/DIMEN_20PX"
            android:text="贴纸相机"
            android:layout_centerInParent="true"
            android:layout_marginEnd="@dimen/DIMEN_20PX"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_right_area"
            android:paddingLeft="@dimen/DIMEN_20PX"
            android:paddingRight="@dimen/DIMEN_20PX"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:paddingStart="@dimen/DIMEN_20PX"
            android:paddingEnd="@dimen/DIMEN_20PX"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="@dimen/DIMEN_32PX"
                android:textColor="@color/white"
                android:id="@+id/title_right"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/DIMEN_18PX"
                android:layout_marginEnd="@dimen/DIMEN_18PX"/>
            <ImageView
                android:id="@+id/title_right_btn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/DIMEN_60PX"
                android:src="@drawable/next"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
