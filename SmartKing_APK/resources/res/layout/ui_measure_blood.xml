<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_title"/>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="#fff"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"
            android:layout_centerHorizontal="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ic_type"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@mipmap/ic_page_blood"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#888"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/ic_type_tips"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginLeft="10dp"
                android:text="@string/current_blood"
                android:layout_marginStart="10dp"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_gravity="center_vertical"
                android:id="@+id/ic_type_value"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginLeft="6dp"
                android:text="-/-mmHg"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <com.czw.smartkit.views.NpHgView
                android:id="@+id/blood1"
                android:layout_width="54dp"
                android:layout_height="220dp"/>
            <com.czw.smartkit.views.NpHgView
                android:id="@+id/blood2"
                android:layout_width="54dp"
                android:layout_height="220dp"
                android:layout_marginLeft="44dp"
                android:layout_marginStart="44dp"/>
        </LinearLayout>
        <Button
            android:textColor="@color/one_key_blood"
            android:id="@+id/measureBtn"
            android:background="@drawable/measore_blood"
            android:layout_width="240dp"
            android:layout_height="40dp"
            android:layout_marginBottom="36dp"
            android:text="@string/start_measure"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </RelativeLayout>
</LinearLayout>
