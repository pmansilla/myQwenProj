<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_title"/>
    <View style="@style/top_line"/>
    <RelativeLayout
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="4">
        <com.czw.smartkit.views.ProgressView
            android:id="@+id/progress"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#000"
            android:gravity="center"
            android:id="@+id/progressTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name_sk"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="6">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <View
                android:layout_alignParentTop="true"
                style="@style/top_line"/>
            <View
                android:layout_alignParentBottom="true"
                style="@style/top_line"/>
            <TextView
                android:id="@+id/firmwareTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/format_firmware"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"/>
        </RelativeLayout>
        <Button
            android:id="@+id/checkoutOtaBtn"
            android:background="@drawable/ota_btn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:text="@string/check_for_update"
            android:layout_centerInParent="true"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </RelativeLayout>
</LinearLayout>
