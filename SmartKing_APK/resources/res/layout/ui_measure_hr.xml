<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/include_title"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ref_title"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ic_type"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@mipmap/ic_page_hr"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#888"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/ic_type_tips"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginLeft="12dp"
            android:text="@string/current_hr"
            android:layout_marginStart="12dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/ic_type_value"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginLeft="6dp"
            android:text="- bpm"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <com.czw.smartkit.views.LineView
        android:id="@+id/lineView"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="12dp"
        android:layout_centerInParent="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <TextView
        android:id="@+id/hr_info"
        android:visibility="invisible"
        android:text="@string/for_mat_hr_info"
        style="@style/wrap"/>
    <Button
        android:textColor="@color/one_key_hr"
        android:id="@+id/measureBtn"
        android:background="@drawable/measore_hr"
        android:layout_width="240dp"
        android:layout_height="40dp"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="36dp"
        android:text="@string/start_measure"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        style="@style/Widget.AppCompat.Button.Borderless"/>
</LinearLayout>
