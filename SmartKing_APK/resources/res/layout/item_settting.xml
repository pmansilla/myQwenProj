<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#0000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout style="@style/setting_rl_layout">
        <ImageView
            android:id="@+id/image"
            android:src="@mipmap/img_set_clock"
            style="@style/setting_rl_layout_left"/>
        <TextView
            android:textSize="16sp"
            android:id="@+id/text"
            style="@style/setting_rl_layout_center"/>
        <ImageView
            android:id="@+id/right"
            style="@style/setting_rl_layout_right"/>
    </RelativeLayout>
</RelativeLayout>
