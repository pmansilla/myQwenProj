<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="#fefffe"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View style="@style/hline"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="16sp"
            android:textColor="#1082ff"
            android:id="@+id/leftItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:minWidth="64dp"
            android:text="@string/cancel"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"/>
        <TextView
            android:textColor="#000"
            android:gravity="center"
            android:id="@+id/centerItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:text="title"
            android:lines="2"
            android:layout_toLeftOf="@+id/rightItem"
            android:layout_toRightOf="@+id/leftItem"
            android:layout_centerInParent="true"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_toStartOf="@+id/rightItem"
            android:layout_toEndOf="@+id/leftItem"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#1082ff"
            android:id="@+id/rightItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:minWidth="64dp"
            android:text="@string/ok"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"/>
        <View
            android:layout_alignParentBottom="true"
            style="@style/hline"/>
    </RelativeLayout>
    <com.wx.wheelview.widget.WheelView
        android:id="@+id/wheelview"
        android:layout_width="match_parent"
        android:layout_height="240dp"/>
</LinearLayout>
